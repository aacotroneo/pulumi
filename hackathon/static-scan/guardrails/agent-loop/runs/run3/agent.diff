+const config = new pulumi.Config();
+
+// Invoices hold customer billing data, so they're classed like receipts: confidential, protected in prod.
+export const invoices = new platform.storage.Bucket("payments-invoices", { team, dataClass: "confidential" }, { provider, protect: isProd });
+
+// Postgres 16. The platform doesn't offer db.t3.micro: dev gets its smallest size, "small" (db.t4g.small), and
+// prod must be "medium" or "large", so prod gets "medium" (db.r6g.large).
+export const db = new platform.db.Postgres(
+    "payments-db",
+    { team, size: isProd ? "medium" : "small", password: config.requireSecret("paymentsDbPassword") },
+    { provider, protect: isProd },
