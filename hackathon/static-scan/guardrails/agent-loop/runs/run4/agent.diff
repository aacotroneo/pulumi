 const team = "payments";
 const isProd = pulumi.getStack() === "prod";
 const provider = platform.provider(team);
+const config = new pulumi.Config();
 
 export const receipts = new platform.storage.Bucket("payments-receipts", { team, dataClass: "confidential" }, { provider, protect: isProd });
+
+// Invoices bucket. Guardrails require the platform component instead of a raw aws.s3.BucketV2.
+export const invoices = new platform.storage.Bucket("payments-invoices", { team, dataClass: "confidential" }, { provider, protect: isProd });
+
+// Payments database: Postgres 16 via the platform component (raw aws.rds.Instance isn't allowed).
+// Sizes are fixed by the platform: small (db.t4g.small) in dev, medium (db.r6g.large) in prod.
+export const db = new platform.db.Postgres(
+    "payments-db",
+    { team, size: isProd ? "medium" : "small", password: config.requireSecret("paymentsDbPassword") },
+    { provider, protect: isProd },
+);
 
 new aws.cloudwatch.LogGroup("payments-api-logs", { retentionInDays: isProd ? 90 : 14 }, { provider });
