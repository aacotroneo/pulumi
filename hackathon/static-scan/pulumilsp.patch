diff --git a/pulumicommand/lint.go b/pulumicommand/lint.go
new file mode 100644
index 0000000..bcc287f
--- /dev/null
+++ b/pulumicommand/lint.go
@@ -0,0 +1,113 @@
+package pulumicommand
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"github.com/corymhall/pulumilsp/debug"
+	rpc "github.com/pulumi/pulumi/sdk/v3/proto/go"
+)
+
+// lintRunner runs `pulumi policy lint --json` on the project instead of a full preview: no stack, login,
+// providers or credentials, and no installed program dependencies.
+type lintRunner struct {
+	root   string
+	packs  []string
+	pulumi string
+}
+
+// LintPacksFromEnv returns the policy packs to lint with (PULUMILSP_LINT_PACKS, a path list); none means lint
+// mode is off and the server runs a preview as before.
+func LintPacksFromEnv() []string {
+	v := os.Getenv("PULUMILSP_LINT_PACKS")
+	if v == "" {
+		return nil
+	}
+	return filepath.SplitList(v)
+}
+
+func NewLint(root string, packs []string) *Runner {
+	bin := os.Getenv("PULUMILSP_PULUMI")
+	if bin == "" {
+		bin = "pulumi"
+	}
+	return &Runner{lint: &lintRunner{root: root, packs: packs, pulumi: bin}}
+}
+
+type lintFinding struct {
+	URI              string `json:"uri"`
+	Line             int32  `json:"line"`
+	Column           int32  `json:"column"`
+	URN              string `json:"urn"`
+	PolicyPack       string `json:"policyPack"`
+	PolicyPackVer    string `json:"policyPackVersion"`
+	Policy           string `json:"policy"`
+	Description      string `json:"description"`
+	EnforcementLevel string `json:"enforcementLevel"`
+	Message          string `json:"message"`
+}
+
+type lintReport struct {
+	Findings   []lintFinding    `json:"findings"`
+	Advisories []lintFinding    `json:"advisories"`
+	Errors     []string         `json:"errors"`
+	Timings    map[string]int64 `json:"timings"`
+}
+
+func enforcementLevel(s string) rpc.EnforcementLevel {
+	switch s {
+	case "mandatory":
+		return rpc.EnforcementLevel_MANDATORY
+	case "remediate":
+		return rpc.EnforcementLevel_REMEDIATE
+	case "disabled":
+		return rpc.EnforcementLevel_DISABLED
+	default:
+		return rpc.EnforcementLevel_ADVISORY
+	}
+}
+
+func (l *lintRunner) run(ctx context.Context) (map[string]*ResourceInfo, error) {
+	args := []string{"policy", "lint", l.root, "--json"}
+	for _, p := range l.packs {
+		args = append(args, "--policy-pack", p)
+	}
+	cmd := exec.CommandContext(ctx, l.pulumi, args...)
+	cmd.Dir = l.root
+	out, runErr := cmd.Output() // exits non-zero on mandatory violations; the report is still on stdout
+	var report lintReport
+	if err := json.Unmarshal(out, &report); err != nil {
+		if runErr != nil {
+			return nil, fmt.Errorf("pulumi policy lint: %w", runErr)
+		}
+		return nil, fmt.Errorf("parsing pulumi policy lint output: %w", err)
+	}
+	debug.Debug.Log(ctx, "pulumi policy lint", "findings", len(report.Findings), "timings", report.Timings)
+	store := &ResourceStore{}
+	for _, f := range append(report.Findings, report.Advisories...) {
+		if f.URI == "" {
+			continue
+		}
+		info := store.getOrCreateResourceInfo(f.URN)
+		info.SetSourcePosition(&rpc.SourcePosition{Uri: f.URI, Line: f.Line, Column: f.Column})
+		msg := f.Message
+		if !strings.Contains(msg, f.Policy) {
+			msg = fmt.Sprintf("[%s/%s] %s", f.PolicyPack, f.Policy, msg)
+		}
+		info.AddDiagnostic(&rpc.AnalyzeDiagnostic{
+			PolicyName:        f.Policy,
+			PolicyPackName:    f.PolicyPack,
+			PolicyPackVersion: f.PolicyPackVer,
+			Description:       f.Description,
+			Message:           msg,
+			EnforcementLevel:  enforcementLevel(f.EnforcementLevel),
+			Urn:               f.URN,
+		})
+	}
+	return store.Resources, nil
+}
